package com.klef.soa.exam.controller;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

import com.klef.soa.exam.entity.LaundryPickupEntity;
import com.klef.soa.exam.service.LaundryPickupService;

@RestController
@RequestMapping("/laundrypickup")
public class LaundryPickupController 
{
	
	
	@Autowired
	private LaundryPickupService service;

	@GetMapping("/")
	public String test()
	{
		return "CRUD Service is running";
	}
	
	
		@PostMapping("/add") 
		public ResponseEntity<LaundryPickupEntity> addpatient(@RequestBody LaundryPickupEntity p) 
		{ 
			LaundryPickupEntity laundry = service.addlaundry(p); 
			return ResponseEntity.status(201).body(laundry); 
		}
		
		
		@GetMapping("/displayall")
		public ResponseEntity<List<Patient>> displayAllPatients()
		{
			List<Patient> patients = service.displayAllPatients(); 
			return ResponseEntity.status(200).body(patients);
		}
	
}
