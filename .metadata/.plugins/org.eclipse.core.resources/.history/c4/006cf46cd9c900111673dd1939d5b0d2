import com.klef.soa.exam.entity.LaundryPickupEntity;
import com.klef.soa.exam.service.LaundryPickupService;

@RestController
@RequestMapping("/laundrypickup")
public class LaundryPickupController 
{
	
	
	@Autowired
	private LaundryPickupService service;

	@GetMapping("/")
	public String test()
	{
		return "CRUD Service is running";
	}
	
	
		@PostMapping("/add") 
		public ResponseEntity<LaundryPickupEntity> addLaundry(@RequestBody LaundryPickupEntity p) 
		{ 
			LaundryPickupEntity laundry = service.addlaundry(p); 
			return ResponseEntity.status(201).body(laundry); 
		}
		
		
		@GetMapping("/displayall")
		public ResponseEntity<List<LaundryPickupEntity>> displayAllPatients()
		{
			List<LaundryPickupEntity> laundry = service.displayallLaundry(); 
			return ResponseEntity.status(200).body(laundry);
		}
	
		
		@DeleteMapping("/delete/{id}")
		public ResponseEntity<String> deletelaundrybyid(@PathVariable Long id)
		{

			String Msg=service.deleteLaundryById(id);

	        
				
		}
}
